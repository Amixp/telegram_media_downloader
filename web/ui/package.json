        "react-dom": "^19.2.0",
        "react-virtuoso": "^4.18.1",
        "recharts": "^3.7.0",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.24",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
