    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" && nvm use && rm -rf node_modules/.vite && vite build || (rm -rf node_modules/.vite && vite build)",
        "build:clean": "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" && nvm use && rm -rf node_modules/.vite ../static && vite build || (rm -rf node_modules/.vite ../static && vite build)",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "framer-motion": "^12.30.0",
        "lucide-react": "^0.563.0",
